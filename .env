# Database connection configuration
DB_HOST=db

# Usuario normal de la BD
DB_USER=admin
DB_PASSWORD=secret

# Nombre de la BD
DB_NAME=gestion_libreria

# Contraseña del root de MySQL
DB_ROOT_PASSWORD=root123


# ----- Backup automático -----
BACKUP_TABLES=Usuario, Libro
BACKUP_RETENTION_WEEKS=4
BACKUP_CRON_SCHEDULE=0 3 * * 0
BACKUP_RUN_ON_START=false